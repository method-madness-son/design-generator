{
  "id": "hockey-bag-warning",
  "title": "CAUTION",
  "subtitle": "HOCKEY BAG INSIDE",
  "body": [
    "Open only in a ventilated area.",
    "Do not make eye contact with the gloves."
  ],
  "icon": {
    "name": "triangle-alert",
    "position": "top",
    "className": "text-[var(--poster-ink)]",
    "sizeRem": 13
  },
  "overrides": {
    "colorPalette": {
      "background": "#F7C600",
      "ink": "#111111",
      "accent": "#111111",
      "blue": "#111111"
    },
    "defaultLayout": {
      "containerClasses": "relative items-center justify-center gap-4 border-[14px] border-[#111111] p-12 text-center"
    },
    "defaultTypography": {
      "titleRem": 7.5,
      "subtitleRem": 2.8,
      "bodyRem": 1.6,
      "subtitleClasses": "font-bold leading-tight tracking-wide text-[var(--poster-ink)]",
      "bodyClasses": "mt-2 space-y-1 font-medium text-[var(--poster-ink)]"
    }
  }
}
