      "titleClasses": "font-bold leading-[0.95] tracking-[0.1em] text-[var(--poster-ink)]",
      "subtitleClasses": "order-last leading-tight text-[var(--poster-ink)]",
      "bodyClasses": "w-full space-y-3 border-y-4 border-dashed border-[var(--poster-ink)] py-6 text-left text-[var(--poster-ink)] [&>li:last-child]:font-bold",
      "titleRem": 4.5,
      "subtitleRem": 1.6,
      "bodyRem": 1.75
    }
  }
}
