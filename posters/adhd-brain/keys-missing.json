      "titleRem": 2.7,
      "bodyRem": 2.3,
      "fontFamily": "var(--font-theme-pixelify-sans), monospace",
      "titleClasses": "whitespace-pre-line font-semibold leading-tight text-[var(--poster-ink)]",
      "subtitleRem": 2,
      "titleFontFamily": "var(--font-theme-pixelify-sans), monospace"
    }
