{
  "id": "stoic-wisdom",
  "title": "Daily Stoic",
  "description": "Museum-placard stoic philosophy posters in carved-stone serif type.",
  "colorPalette": {
    "background": "#121212",
    "ink": "#F0EAD6",
    "accent": "#CD7F32"
  },
  "defaultLayout": {
    "aspectRatio": "4/5",
    "printWidthInches": 8,
    "containerClasses": "items-center justify-center gap-6 p-16 text-center"
  },
  "defaultBackground": {
    "className": "bg-[var(--poster-background)]"
  },
  "defaultTypography": {
    "fontFamily": "var(--font-cinzel), serif",
    "titleClasses": "font-bold uppercase tracking-[0.2em] text-[var(--poster-ink)]",
    "subtitleClasses": "italic leading-relaxed whitespace-pre-line text-[var(--poster-ink)]",
    "bodyClasses": "space-y-2 text-xl text-[var(--poster-ink)]",
    "titleRem": 3.75,
    "subtitleRem": 1.75
  },
  "palettes": {
    "bronze": {
      "accent": "#CD7F32"
    },
    "marble": {
      "accent": "#F0EAD6"
    },
    "slate": {
      "accent": "#2C3539"
    }
  },
  "fontPairs": {
    "classic": {
      "title": "var(--font-cinzel), serif",
      "body": "var(--font-playfair-display), serif"
    }
  },
  "iconRem": 5,
  "sizeScale": {
    "icon": [3, 4, 5, 6, 7, 8],
    "title": [2.5, 3, 3.25, 3.75, 4, 4.5],
    "subtitle": [1.25, 1.5, 1.75, 2, 2.25]
  }
}
