{
  "id": "ancient-strategist",
  "title": "The Strategist",
  "description": "Ink-brush discipline posters pairing ancient warfare and leadership wisdom with stark, restrained typography.",
  "colorPalette": {
    "background": "#15120F",
    "ink": "#EDE6D6",
    "accent": "#A8201A"
  },
  "defaultLayout": {
    "aspectRatio": "4/5",
    "printWidthInches": 8,
    "containerClasses": "items-center justify-center gap-5 p-14 text-center"
  },
  "defaultBackground": {
    "className": "bg-[var(--poster-background)]"
  },
  "defaultTypography": {
    "fontFamily": "var(--font-fraunces), serif",
    "titleClasses": "font-bold uppercase tracking-[0.1em] text-[var(--poster-ink)]",
    "subtitleClasses": "italic text-[var(--poster-accent)]",
    "bodyClasses": "space-y-2 text-xl text-[var(--poster-ink)]",
    "titleRem": 2.5,
    "subtitleRem": 1.25
  },
  "palettes": {
    "crimson": {
      "accent": "#A8201A"
    },
    "paper": {
      "accent": "#EDE6D6"
    }
  },
  "iconRem": 5,
  "sizeScale": {
    "icon": [3, 4, 5, 6, 7, 8],
    "title": [1.75, 2, 2.25, 2.5, 2.75, 3, 3.25],
    "subtitle": [1, 1.125, 1.25, 1.5, 1.75]
  }
}
