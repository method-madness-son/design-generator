    "titleRem": 2.75,
    "subtitleRem": 1.5
  },
  "palettes": {
    "ethereal": {
      "accent": "#C9D6E3"
    },
    "gold": {
      "accent": "#C9A227"
    },
    "crimson": {
      "accent": "#A42C3B"
    }
  },
  "iconRem": 6,
  "sizeScale": {
    "icon": [4, 5, 6, 7, 8, 9],
    "title": [1.75, 2, 2.25, 2.5, 2.75, 3, 3.25, 3.5],
    "subtitle": [1, 1.25, 1.5, 1.75, 2]
