{
  "id": "mtg-lgs-rules",
  "title": "MTG LGS Rules",
  "description": "Dark-mode rules-reference posters for zones, formats, deckbuilding, and events at the local game store.",
  "colorPalette": {
    "background": "#121212",
    "ink": "#F5F2EA",
    "accent": "#D4A017"
  },
  "defaultLayout": {
    "aspectRatio": "4/5",
    "printWidthInches": 8,
    "containerClasses": "items-center justify-center gap-6 p-14 text-center"
  },
  "defaultBackground": {
    "className": "bg-[var(--poster-background)]"
  },
  "defaultTypography": {
    "fontFamily": "var(--font-lexend), sans-serif",
    "titleClasses": "font-bold tracking-tight text-[var(--poster-ink)]",
    "subtitleClasses": "font-medium text-[var(--poster-accent)]",
    "bodyClasses": "space-y-2 text-xl text-[var(--poster-ink)]",
    "titleRem": 3.25,
    "subtitleRem": 1.5
  },
  "palettes": {
    "white": {
      "accent": "#E8E1CC"
    },
    "blue": {
      "accent": "#3B82C4"
    },
    "black": {
      "accent": "#9C8FAE"
    },
    "red": {
      "accent": "#D1453D"
    },
    "gold": {
      "accent": "#D4A017"
    }
  },
  "iconRem": 6,
  "sizeScale": {
    "icon": [4, 5, 6, 7, 8, 9],
    "title": [2, 2.25, 2.5, 2.75, 3, 3.25, 3.5, 3.75, 4],
    "subtitle": [1, 1.25, 1.5, 1.75, 2]
  }
}
