  "rules": {
    "do": [
      "Make the text/message the main design element",
      "Use one display + one supporting font",
      "Use rainbow infinity (ND), gold infinity (autism), or butterfly",
      "Use first-person, humorous, identity-affirming language",
      "Pick ink from the palette's on_light_shirt/on_dark_shirt set matching the shirt's is_dark flag",
      "Require contrast >=3.0 for all ink; >=4.5 for small text",
      "Run a USPTO (Class 25) trademark search for every phrase before listing",
      "Keep a license screenshot/record with each design",
      "Prefer DTG or water-based ink for large prints"
    ],
    "dont": [
      "No puzzle piece for autism",
      "No blue-only 'Light It Up Blue' look",
      "No fix/cure framing",
      "No mixing decades in one design",
      "No Monoton under 3in letter height",
      "No personal-use-only fonts (e.g., Keep on Truckin')",
      "No brand names or character IP (Autism Speaks, team/manufacturer logos)",
      "No scripts for key words in dyslexia-themed designs"
    ],
    "trademark_watch": [
      {
        "phrase": "NEUROSPICY",
        "note": "USPTO Reg. 8233894 for dietary supplements; 2023 application for dating services; not Class 25 per guide but not exhaustively checked"
      }
    ]
  }
